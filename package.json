{
  "name": "aspire-lms-monorepo",
  "version": "1.0.0",
  "description": "Aspire LMS Full-Stack Application Monorepo with separated Frontend & Backend directories",
  "private": true,
  "scripts": {
    "dev": "vite frontend",
    "start:frontend": "vite frontend",
